# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local

# "mongo" (default) or "memory" (no database; data is lost on restart).
STORAGE_BACKEND=mongo
# Use a database of its own; narada writes fake candidates and test runs into it.
MONGODB_CONNECTION_URL=mongodb://localhost:27017
DB_NAME=narada

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Language model (writes test candidates, plays both sides, scores calls). Any
# OpenAI-compatible server. Default: a local Ollama (`ollama pull gemma3:12b`, `ollama serve`).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:12b
# OpenAI's gpt-5 / o-series need max_completion_tokens; everything else reads max_tokens.
LLM_MAX_TOKENS_PARAM=max_tokens
# json_schema for Ollama/OpenAI; json_object for Groq.
LLM_JSON_MODE=json_schema
# Groq instead of Ollama: LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.3-70b-versatile,
# LLM_JSON_MODE=json_object, and LLM_API_KEY from console.groq.com.

# Spend limits for chat-mode runs.
MAX_CONVERSATIONS_PER_RUN=30
MAX_AGENT_TURNS=20
RUN_CONCURRENCY=3

# Gnani (Vachana) speech APIs: STT + TTS (https://app.gnani.ai/voice/)
GNANI_API_KEY=
GNANI_AGENT_VOICE=Shivani
# Requests the Gnani account allows at once (starter plan: 1; raise it on a bigger plan).
GNANI_MAX_PARALLEL_REQUESTS=1
# Where voice-mode recordings are written (one WAV per conversation).
RECORDINGS_DIR=var/recordings